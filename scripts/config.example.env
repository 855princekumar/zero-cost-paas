# Copy to keys/config.env (git-ignored), fill in, then:  set -a; . keys/config.env; set +a
# Every value is explained in docs/03-placeholders.md

# --- domain / DNS ---------------------------------------------------------------
DUCKDNS_DOMAIN=<DUCKDNS_SUBDOMAIN>              # e.g. myapps  ->  myapps.duckdns.org
VPS_DOMAIN=<DUCKDNS_SUBDOMAIN>.duckdns.org      # <BASE_DOMAIN>: Coolify dashboard + wildcard for apps
DUCKDNS_TOKEN=<DUCKDNS_TOKEN>                   # SECRET: can repoint your domain

# --- email alerts (Gmail SMTP, port 587 STARTTLS) ---------------------------------
ALERT_EMAIL=<ALERT_EMAIL>                       # sends and receives alerts
GMAIL_APP_PASSWORD=<GMAIL_APP_PASSWORD>         # SECRET: Google App Password, not your Gmail password
REPORT_TZ=UTC                                   # timezone for the 09:00 daily report, e.g. Europe/Berlin

# --- access -------------------------------------------------------------------------
SSH_PORT=22022                                  # public SSH port (22 stays internal-only for Coolify)

# --- Coolify headless install (used once by coolify-setup.sh) ---------------------
ADMIN_USERNAME=<ADMIN_USERNAME>
ADMIN_PASSWORD=<ADMIN_PASSWORD>                 # SECRET: >=8 chars, upper+lower+digit+symbol; change in UI + enable 2FA

# --- OCI ------------------------------------------------------------------------------
OCI_CONFIG_FILE=~/.oci/config                   # contains <OCI_USER_OCID>, <OCI_TENANCY_OCID>, <OCI_REGION>, key path
